<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Grade 5 Math · Star Board</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@600;700;800&family=Nunito:wght@500;600;700;800&display=swap" rel="stylesheet">
<style>
:root{
  --bg:#F6F4FB; --card:#FFFFFF; --ink:#1E1B2E; --muted:#6B6880; --line:#E7E3F1;
  --purple:#8E2C8B; --purple-d:#6B1F69; --purple-t:#F5EAF5;
  --gold:#F5B700; --silver:#A9B4C2; --bronze:#D9895B;
  --green:#18A85A; --red:#E5484D; --blue:#2F7FD8;
  --shadow:0 1px 2px rgba(30,27,46,.06),0 8px 24px rgba(30,27,46,.07);
  --radius:20px;
}
*{box-sizing:border-box}
html,body{margin:0}
body{font-family:'Nunito',system-ui,sans-serif;color:var(--ink);background:var(--bg);
  background-image:radial-gradient(circle at 8% 0%,#F1E3F6 0,transparent 32%),radial-gradient(circle at 100% 20%,#E4F0FF 0,transparent 30%),radial-gradient(#E3DEEE 1px,transparent 1.2px);
  background-size:auto,auto,22px 22px;min-height:100vh}
button{font:inherit;cursor:pointer;border:0;background:none;color:inherit}
button:focus-visible,input:focus-visible{outline:3px solid #B98AD9;outline-offset:2px}
.wrap{max-width:1280px;margin:0 auto;padding:22px 20px 60px}

/* ---------- header ---------- */
header{display:flex;align-items:center;gap:18px;flex-wrap:wrap;margin-bottom:22px}
header img{height:58px}
.title{flex:1;min-width:240px}
.title h1{font-family:'Baloo 2','Nunito',system-ui,'Segoe UI',Arial,sans-serif;font-size:34px;line-height:1;margin:0;color:var(--purple-d);letter-spacing:.2px}
.title p{margin:6px 0 0;color:var(--muted);font-weight:700}
.tools{display:flex;gap:10px;flex-wrap:wrap}
.tbtn{display:inline-flex;align-items:center;gap:8px;padding:10px 14px;border-radius:14px;background:#fff;box-shadow:var(--shadow);font-weight:800;font-size:14px;transition:transform .15s,background .15s}
.tbtn:hover{transform:translateY(-2px)}
.tbtn.danger{color:var(--red)}
.tbtn[disabled]{opacity:.45;cursor:not-allowed;transform:none}
.tbtn svg{width:18px;height:18px}

/* ---------- champion + podium ---------- */
.hero{display:grid;grid-template-columns:1.05fr 1.4fr;gap:18px;margin-bottom:22px}
.panel{background:var(--card);border-radius:var(--radius);box-shadow:var(--shadow);padding:20px}
.champ{position:relative;overflow:hidden;background:linear-gradient(135deg,#8E2C8B 0%,#B0469F 55%,#E06BA8 100%);color:#fff}
.champ .lbl{font-weight:800;letter-spacing:1.6px;font-size:12px;text-transform:uppercase;opacity:.9}
.champ .name{font-family:'Baloo 2','Nunito',system-ui,'Segoe UI',Arial,sans-serif;font-size:30px;line-height:1.1;margin:10px 0 6px;min-height:66px}
.champ .pts{font-weight:800;font-size:16px;opacity:.95}
.champ .crown{position:absolute;right:16px;top:12px;width:96px;height:96px;opacity:.95;filter:drop-shadow(0 6px 10px rgba(0,0,0,.18))}
.champ .sparks{position:absolute;inset:0;pointer-events:none;background-image:radial-gradient(#fff 1px,transparent 1.5px);background-size:26px 26px;opacity:.15}
.champ.empty .name{font-size:22px;opacity:.95}
.podium{display:flex;align-items:flex-end;justify-content:center;gap:12px;height:100%;min-height:190px}
.pod{flex:1;max-width:190px;text-align:center;display:flex;flex-direction:column;align-items:center}
.pod .av{width:54px;height:54px;font-size:20px;margin-bottom:6px}
.pod .pn{font-weight:800;font-size:14px;line-height:1.15;min-height:34px;display:flex;align-items:flex-end}
.pod .ps{font-size:13px;color:var(--muted);font-weight:800;margin:2px 0 6px}
.pod .block{width:100%;border-radius:14px 14px 6px 6px;display:flex;align-items:flex-start;justify-content:center;font-family:'Baloo 2','Nunito',system-ui,'Segoe UI',Arial,sans-serif;font-size:28px;color:#fff;padding-top:6px;transition:height .5s cubic-bezier(.2,.9,.3,1.2)}
.p1 .block{height:96px;background:linear-gradient(180deg,#FFD24A,#F2A900)}
.p2 .block{height:70px;background:linear-gradient(180deg,#C9D2DD,#98A5B5)}
.p3 .block{height:52px;background:linear-gradient(180deg,#F0AE85,#CF7A4C)}
.pod.blank{opacity:.35}

/* ---------- controls ---------- */
.bar{display:flex;gap:12px;align-items:center;flex-wrap:wrap;margin-bottom:16px}
.search{flex:1;min-width:220px;position:relative}
.search input{width:100%;padding:12px 14px 12px 42px;border-radius:14px;border:1.5px solid var(--line);background:#fff;font:inherit;font-weight:700;color:var(--ink)}
.search svg{position:absolute;left:14px;top:50%;transform:translateY(-50%);width:18px;height:18px;color:var(--muted)}
.seg{display:inline-flex;background:#fff;border-radius:14px;padding:4px;box-shadow:var(--shadow)}
.seg button{padding:8px 12px;border-radius:10px;font-weight:800;font-size:13px;color:var(--muted)}
.seg button.on{background:var(--purple);color:#fff}
.step{display:inline-flex;align-items:center;gap:6px;font-weight:800;font-size:13px;color:var(--muted)}
.stats{display:flex;gap:10px;flex-wrap:wrap;margin-bottom:16px}
.stat{background:#fff;border-radius:14px;padding:10px 14px;box-shadow:var(--shadow);font-weight:800;font-size:13px;color:var(--muted)}
.stat b{color:var(--ink);font-size:18px;margin-left:6px}

/* ---------- cards ---------- */
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(285px,1fr));gap:14px}
.card{position:relative;background:var(--card);border-radius:var(--radius);box-shadow:var(--shadow);padding:16px 16px 14px;display:flex;flex-direction:column;gap:12px;border:2px solid transparent;transition:transform .2s,border-color .2s,box-shadow .2s}
.card:hover{transform:translateY(-2px)}
.card.leader{border-color:var(--gold);box-shadow:0 0 0 4px rgba(245,183,0,.15),var(--shadow)}
.top{display:flex;gap:12px;align-items:center}
.av{flex:none;width:46px;height:46px;border-radius:50%;display:grid;place-items:center;color:#fff;font-family:'Baloo 2','Nunito',system-ui,'Segoe UI',Arial,sans-serif;font-weight:800;font-size:17px}
.nm{flex:1;min-width:0}
.nm .first{font-weight:800;font-size:17px;line-height:1.15}
.nm .rest{font-size:12.5px;color:var(--muted);font-weight:700;line-height:1.25;margin-top:2px}
.rank{flex:none;font-weight:800;font-size:12px;color:var(--muted);background:#F3F1F8;border-radius:999px;padding:4px 9px}
.rank.r1{background:#FFF4CC;color:#8A6400}.rank.r2{background:#EEF1F5;color:#5A6676}.rank.r3{background:#FBEADF;color:#8E4B24}
.mid{display:flex;align-items:center;gap:10px}
.score{font-family:'Baloo 2','Nunito',system-ui,'Segoe UI',Arial,sans-serif;font-size:44px;font-weight:800;line-height:1;min-width:76px;color:var(--purple-d);font-variant-numeric:tabular-nums}
.score.bump{animation:bump .35s}
.score.dip{animation:dip .35s}
@keyframes bump{40%{transform:scale(1.28);color:var(--green)}}
@keyframes dip{40%{transform:scale(.85);color:var(--red)}}
.meter{flex:1;height:10px;background:#F0EDF6;border-radius:999px;overflow:hidden}
.meter i{display:block;height:100%;width:0;background:linear-gradient(90deg,#B0469F,#F5B700);border-radius:999px;transition:width .45s cubic-bezier(.2,.9,.3,1)}
.acts{display:grid;grid-template-columns:1fr 1fr auto;gap:8px}
.b{height:44px;border-radius:14px;font-weight:800;font-size:16px;display:flex;align-items:center;justify-content:center;gap:6px;transition:transform .1s,filter .15s}
.b:active{transform:scale(.95)}
.b.plus{background:#E7F7EE;color:#0E7A40}.b.plus:hover{filter:brightness(.97)}
.b.minus{background:#FDECEC;color:#B4232A}.b.minus:hover{filter:brightness(.97)}
.b.reset{width:44px;background:#F3F1F8;color:var(--muted)}
.b[disabled]{opacity:.4;cursor:not-allowed}
.float{position:absolute;right:22px;top:58px;font-family:'Baloo 2','Nunito',system-ui,'Segoe UI',Arial,sans-serif;font-weight:800;font-size:22px;pointer-events:none;animation:fl .9s ease-out forwards}
@keyframes fl{from{opacity:1;transform:translateY(0)}to{opacity:0;transform:translateY(-38px)}}
.empty-msg{grid-column:1/-1;text-align:center;color:var(--muted);font-weight:800;padding:30px}

/* ---------- modal & toast ---------- */
.scrim{position:fixed;inset:0;background:rgba(30,27,46,.35);display:none;align-items:center;justify-content:center;padding:16px;z-index:50}
.scrim.show{display:flex}
.modal{background:#fff;border-radius:22px;max-width:420px;width:100%;padding:24px;box-shadow:0 20px 60px rgba(30,27,46,.25);text-align:center}
.modal h3{font-family:'Baloo 2','Nunito',system-ui,'Segoe UI',Arial,sans-serif;font-size:24px;margin:0 0 6px}
.modal p{color:var(--muted);font-weight:700;margin:0 0 18px}
.modal .row{display:flex;gap:10px;justify-content:center}
.mbtn{padding:11px 18px;border-radius:14px;font-weight:800}
.mbtn.cancel{background:#F3F1F8}.mbtn.go{background:var(--red);color:#fff}
.toast{position:fixed;left:50%;bottom:22px;transform:translateX(-50%) translateY(120px);background:var(--ink);color:#fff;padding:12px 16px;border-radius:14px;font-weight:800;display:flex;gap:14px;align-items:center;transition:transform .3s;z-index:60;box-shadow:0 10px 30px rgba(0,0,0,.2)}
.toast.show{transform:translateX(-50%) translateY(0)}
.toast button{color:#F5B700;font-weight:800}
canvas#fx{position:fixed;inset:0;pointer-events:none;z-index:70}

@media (max-width:900px){.hero{grid-template-columns:1fr}}
@media (max-width:520px){.title h1{font-size:27px}header img{height:46px}.score{font-size:38px}}
@media print{.tools,.bar,.acts,.toast,canvas{display:none!important}body{background:#fff}.card,.panel{box-shadow:none;border:1px solid #ddd}}
@media (prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}
</style>
</head>
<body>
<canvas id="fx"></canvas>
<div class="wrap">
  <header>
    <img src="data:image/png;base64," alt="NASA International Schools">
    <div class="title">
      <h1>Grade 5 Math · Star Board</h1>
      <p>Who is the top mathematician today? <span id="dateLbl"></span></p>
    </div>
    <div class="tools">
      <button class="tbtn" id="undoBtn" disabled title="Undo the last change (Ctrl+Z)">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M9 14 4 9l5-5"/><path d="M4 9h11a5 5 0 0 1 0 10h-3"/></svg>Undo</button>
      <button class="tbtn" id="soundBtn" title="Sound on/off"></button>
      <button class="tbtn" id="csvBtn" title="Download the scores as a spreadsheet (CSV)">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v12"/><path d="m7 10 5 5 5-5"/><path d="M5 21h14"/></svg>Export</button>
      <button class="tbtn danger" id="resetAll">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 1 0 3-6.7"/><path d="M3 4v5h5"/></svg>Reset all</button>
    </div>
  </header>

  <section class="hero">
    <div class="panel champ" id="champ">
      <div class="sparks"></div>
      <svg class="crown" viewBox="0 0 64 64"><path d="M8 22l12 10 12-18 12 18 12-10-6 28H14z" fill="#FFD24A" stroke="#fff" stroke-width="2.5" stroke-linejoin="round"/><circle cx="8" cy="20" r="4" fill="#fff"/><circle cx="32" cy="12" r="4" fill="#fff"/><circle cx="56" cy="20" r="4" fill="#fff"/><rect x="14" y="50" width="36" height="6" rx="3" fill="#F2A900" stroke="#fff" stroke-width="2"/></svg>
      <div class="lbl">⭐ Star of the class</div>
      <div class="name" id="champName"></div>
      <div class="pts" id="champPts"></div>
    </div>
    <div class="panel">
      <div class="podium" id="podium"></div>
    </div>
  </section>

  <div class="bar">
    <label class="search"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
      <input id="q" type="search" placeholder="Find a student…" aria-label="Find a student"></label>
    <div class="seg" role="group" aria-label="Sort">
      <button data-sort="list" class="on">Class list</button>
      <button data-sort="score">Highest score</button>
      <button data-sort="az">A – Z</button>
    </div>
    <div class="step">Points per click
      <div class="seg" role="group" aria-label="Points per click">
        <button data-step="1" class="on">1</button><button data-step="2">2</button><button data-step="5">5</button>
      </div>
    </div>
  </div>

  <div class="stats">
    <div class="stat">Students<b id="sCount">0</b></div>
    <div class="stat">Total points<b id="sTotal">0</b></div>
    <div class="stat">Class average<b id="sAvg">0</b></div>
    <div class="stat">With points<b id="sActive">0</b></div>
  </div>

  <main class="grid" id="grid"></main>
</div>

<div class="scrim" id="scrim" role="dialog" aria-modal="true" aria-labelledby="mTitle">
  <div class="modal">
    <h3 id="mTitle">Reset every score?</h3>
    <p id="mText">All 17 students will go back to 0. You can undo this straight after.</p>
    <div class="row"><button class="mbtn cancel" id="mNo">Cancel</button><button class="mbtn go" id="mYes">Reset all</button></div>
  </div>
</div>
<div class="toast" id="toast"><span id="tMsg"></span><button id="tUndo">Undo</button></div>

<script>
/* ---------------- students (exactly as provided, in class-list order) ---------------- */
const STUDENTS = [
  "Adhm Amr Adel Elserafy",
  "Ahmed Abdulaziz Adi Faidi",
  "Alwaleed Abdulaziz Ahmed Alyamani",
  "Elyas Abdullah Abdelhamid Albatayneh",
  "Eyad Mohamed Ahmed Moanes Alsherif",
  "Ibrahim Mohamed Ibrahim Hamedelnil",
  "Karam Bahaa Adden Yacoub Hindi",
  "Kenan Mohammed Khalil Makkawi",
  "Laith Mohammed Abdallatif Khalil",
  "Rashed Mohammed Yeahya Qati",
  "Rayan Adnan Adnan Yousaf Muhammad Yousaf Adnan",
  "Sattam Rakan Ahmed Alghuraybi",
  "Wessam Muhammad Al Hourani",
  "Yousef Khader Ahmad Al Zahrani",
  "Yusuf Mohammed Adel Qamhawi",
  "Abdallah Al Shehri",
  "Houssam Al Malki"
];
const KEY = 'nasa-g5-math-starboard-v1';
const COLORS = ['#8E2C8B','#2F7FD8','#18A85A','#E5484D','#F08C00','#7048E8','#0CA5B0','#D6336C','#5C7CFA','#2B8A3E','#C2410C','#9C36B5','#1C7ED6','#E8590C','#0B7285','#A61E4D','#5F3DC4'];

/* ---------------- state ---------------- */
let scores = STUDENTS.map(() => 0);
let sortMode = 'list', step = 1, query = '', sound = true;
const history = [];               // undo stack of previous score arrays
let lastLeaders = '';

function load() {
  try {
    const d = JSON.parse(localStorage.getItem(KEY) || 'null');
    if (d && Array.isArray(d.names) && Array.isArray(d.scores)) {
      // match saved scores by exact name, so the list can never shift scores between students
      scores = STUDENTS.map(n => { const i = d.names.indexOf(n); return i >= 0 && Number.isFinite(d.scores[i]) ? Math.max(0, d.scores[i]) : 0; });
      if (typeof d.sound === 'boolean') sound = d.sound;
    }
  } catch (e) {}
}
function save() { try { localStorage.setItem(KEY, JSON.stringify({ names: STUDENTS, scores, sound, saved: Date.now() })); } catch (e) {} }

/* ---------------- helpers ---------------- */
const $ = s => document.querySelector(s);
const split = n => { const p = n.split(' '); return { first: p[0], rest: p.slice(1).join(' ') }; };
const initials = n => { const p = n.split(' '); return (p[0][0] + p[p.length - 1][0]).toUpperCase(); };
const esc = s => s.replace(/[&<>"]/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));
function ranks() {   // standard competition ranking: ties share a rank (1, 1, 3 ...)
  return scores.map(s => 1 + scores.filter(x => x > s).length);
}
function pushHistory() { history.push(scores.slice()); if (history.length > 200) history.shift(); $('#undoBtn').disabled = false; }

/* ---------------- sound ---------------- */
let ac;
function tone(freqs, dur = 0.09, type = 'triangle', vol = 0.08) {
  if (!sound) return;
  try {
    ac = ac || new (window.AudioContext || window.webkitAudioContext)();
    freqs.forEach((f, i) => {
      const o = ac.createOscillator(), g = ac.createGain(), t = ac.currentTime + i * dur * 0.9;
      o.type = type; o.frequency.value = f; g.gain.setValueAtTime(0, t); g.gain.linearRampToValueAtTime(vol, t + 0.01); g.gain.exponentialRampToValueAtTime(0.0001, t + dur * 1.6);
      o.connect(g).connect(ac.destination); o.start(t); o.stop(t + dur * 1.8);
    });
  } catch (e) {}
}
function setSoundBtn() {
  $('#soundBtn').innerHTML = (sound
    ? '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M11 5 6 9H3v6h3l5 4z"/><path d="M15.5 8.5a5 5 0 0 1 0 7"/><path d="M18.5 5.5a9 9 0 0 1 0 13"/></svg>Sound on'
    : '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M11 5 6 9H3v6h3l5 4z"/><path d="m22 9-6 6"/><path d="m16 9 6 6"/></svg>Sound off');
}

/* ---------------- confetti ---------------- */
const cv = $('#fx'), cx = cv.getContext('2d'); let parts = [], raf = 0;
function sizeCanvas() { cv.width = innerWidth * devicePixelRatio; cv.height = innerHeight * devicePixelRatio; }
addEventListener('resize', sizeCanvas); sizeCanvas();
function confetti(x, y, n = 90) {
  if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
  const cols = ['#8E2C8B', '#F5B700', '#2F7FD8', '#18A85A', '#E5484D', '#E06BA8'];
  for (let i = 0; i < n; i++) parts.push({ x: x * devicePixelRatio, y: y * devicePixelRatio, vx: (Math.random() - .5) * 14, vy: -Math.random() * 14 - 4, g: .45, s: 4 + Math.random() * 6, r: Math.random() * 6, vr: (Math.random() - .5) * .3, c: cols[i % cols.length], life: 120 });
  if (!raf) loop();
}
function loop() {
  cx.clearRect(0, 0, cv.width, cv.height);
  parts = parts.filter(p => p.life-- > 0 && p.y < cv.height + 40);
  parts.forEach(p => { p.vy += p.g; p.x += p.vx * devicePixelRatio * .5; p.y += p.vy * devicePixelRatio * .5; p.vx *= .99; p.r += p.vr;
    cx.save(); cx.translate(p.x, p.y); cx.rotate(p.r); cx.fillStyle = p.c; cx.fillRect(-p.s, -p.s / 2, p.s * 2, p.s); cx.restore(); });
  raf = parts.length ? requestAnimationFrame(loop) : 0;
  if (!raf) cx.clearRect(0, 0, cv.width, cv.height);
}

/* ---------------- actions ---------------- */
function change(i, delta, el) {
  const before = scores[i], after = Math.max(0, before + delta);
  if (after === before) return;
  pushHistory();
  scores[i] = after; save();
  render(i, after > before ? 'bump' : 'dip', after - before);
  if (after > before) tone([660, 990]); else tone([330, 247], .1, 'sine');
  checkNewLeader(el);
}
function resetOne(i) {
  if (scores[i] === 0) return;
  pushHistory(); const name = split(STUDENTS[i]).first; scores[i] = 0; save(); render(i, 'dip');
  toast(`${name}'s score is back to 0`); tone([440, 330], .1, 'sine');
}
function resetAll() {
  pushHistory(); scores = STUDENTS.map(() => 0); save(); lastLeaders = ''; render();
  toast('All scores are back to 0'); tone([523, 392, 262], .12, 'sine');
}
function undo() {
  if (!history.length) return;
  scores = history.pop(); save(); render(); lastLeaders = leadersKey();
  $('#undoBtn').disabled = !history.length; tone([392, 523], .08);
}
function leadersKey() { const m = Math.max(...scores); return m > 0 ? scores.map((s, i) => s === m ? i : -1).filter(i => i >= 0).join(',') : ''; }
function checkNewLeader(el) {
  const k = leadersKey();
  if (k && k !== lastLeaders) {
    const ids = k.split(',').map(Number);
    if (ids.length === 1 && String(ids[0]) !== lastLeaders) {
      const r = el ? el.getBoundingClientRect() : { left: innerWidth / 2, top: innerHeight / 3, width: 0 };
      confetti(r.left + r.width / 2, r.top); tone([523, 659, 784, 1047], .1, 'triangle', .07);
    }
  }
  lastLeaders = k;
}

/* ---------------- toast ---------------- */
let tt;
function toast(msg) {
  $('#tMsg').textContent = msg; $('#toast').classList.add('show');
  clearTimeout(tt); tt = setTimeout(() => $('#toast').classList.remove('show'), 4200);
}

/* ---------------- render ---------------- */
function order() {
  const idx = STUDENTS.map((_, i) => i);
  if (sortMode === 'score') idx.sort((a, b) => scores[b] - scores[a] || a - b);
  if (sortMode === 'az') idx.sort((a, b) => STUDENTS[a].localeCompare(STUDENTS[b]));
  return idx.filter(i => STUDENTS[i].toLowerCase().includes(query.toLowerCase()));
}
function render(changed = -1, anim = '', delta = 0) {
  const r = ranks(), max = Math.max(...scores), idx = order();
  // cards
  const grid = $('#grid');
  grid.innerHTML = idx.length ? '' : '<div class="empty-msg">No student matches that search.</div>';
  idx.forEach(i => {
    const { first, rest } = split(STUDENTS[i]);
    const lead = max > 0 && scores[i] === max;
    const rk = scores[i] > 0 ? r[i] : null;
    const card = document.createElement('article');
    card.className = 'card' + (lead ? ' leader' : '');
    card.innerHTML = `
      <div class="top">
        <div class="av" style="background:${COLORS[i % COLORS.length]}">${initials(STUDENTS[i])}</div>
        <div class="nm"><div class="first">${esc(first)}</div><div class="rest">${esc(rest)}</div></div>
        <div class="rank ${rk && rk <= 3 ? 'r' + rk : ''}">${rk ? (rk === 1 ? '👑 #1' : '#' + rk) : '#' + (i + 1) + ' on list'}</div>
      </div>
      <div class="mid"><div class="score ${i === changed ? anim : ''}">${scores[i]}</div><div class="meter"><i style="width:${max ? (scores[i] / max * 100) : 0}%"></i></div></div>
      <div class="acts">
        <button class="b plus" aria-label="Add ${step} to ${esc(STUDENTS[i])}">+${step}</button>
        <button class="b minus" aria-label="Take ${step} from ${esc(STUDENTS[i])}" ${scores[i] === 0 ? 'disabled' : ''}>−${step}</button>
        <button class="b reset" title="Reset ${esc(first)} to 0" aria-label="Reset ${esc(STUDENTS[i])} to 0" ${scores[i] === 0 ? 'disabled' : ''}>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 1 0 3-6.7"/><path d="M3 4v5h5"/></svg></button>
      </div>`;
    const [p, m, z] = card.querySelectorAll('button');
    p.onclick = () => change(i, step, p); m.onclick = () => change(i, -step, m); z.onclick = () => resetOne(i);
    if (i === changed && delta) {
      const f = document.createElement('div'); f.className = 'float';
      f.style.color = delta > 0 ? 'var(--green)' : 'var(--red)'; f.textContent = (delta > 0 ? '+' : '−') + Math.abs(delta);
      card.appendChild(f); setTimeout(() => f.remove(), 950);
    }
    grid.appendChild(card);
  });
  // champion
  const leaders = STUDENTS.map((n, i) => i).filter(i => max > 0 && scores[i] === max);
  const ch = $('#champ');
  if (!leaders.length) { ch.classList.add('empty'); $('#champName').textContent = 'Everyone starts at 0 — who will shine first?'; $('#champPts').textContent = 'Give a point to start the race'; }
  else {
    ch.classList.remove('empty');
    $('#champName').textContent = leaders.length === 1 ? STUDENTS[leaders[0]] : leaders.map(i => split(STUDENTS[i]).first).join(' · ');
    $('#champPts').textContent = `${max} point${max === 1 ? '' : 's'}` + (leaders.length > 1 ? ` · ${leaders.length}-way tie for 1st` : '');
  }
  // podium: top three distinct students by score (ties broken by class-list order, ranks shown honestly)
  const top = STUDENTS.map((_, i) => i).filter(i => scores[i] > 0).sort((a, b) => scores[b] - scores[a] || a - b).slice(0, 3);
  const slot = (pos, cls) => {
    const i = top[pos];
    if (i === undefined) return `<div class="pod ${cls} blank"><div class="av" style="background:#CFC9DD">?</div><div class="pn">—</div><div class="ps">0 pts</div><div class="block"></div></div>`;
    return `<div class="pod ${cls}"><div class="av" style="background:${COLORS[i % COLORS.length]}">${initials(STUDENTS[i])}</div>
      <div class="pn">${esc(split(STUDENTS[i]).first)}</div><div class="ps">${scores[i]} pt${scores[i] === 1 ? '' : 's'}</div><div class="block">${r[i]}</div></div>`;
  };
  $('#podium').innerHTML = slot(1, 'p2') + slot(0, 'p1') + slot(2, 'p3');
  // stats
  const total = scores.reduce((a, b) => a + b, 0);
  $('#sCount').textContent = STUDENTS.length; $('#sTotal').textContent = total;
  $('#sAvg').textContent = (Math.round(total / STUDENTS.length * 10) / 10).toString();
  $('#sActive').textContent = scores.filter(s => s > 0).length;
}

/* ---------------- CSV export ---------------- */
function exportCSV() {
  const r = ranks();
  const rows = [['#', 'Student', 'Score', 'Rank']].concat(STUDENTS.map((n, i) => [i + 1, n, scores[i], scores[i] > 0 ? r[i] : '']));
  const csv = '﻿' + rows.map(row => row.map(v => `"${String(v).replace(/"/g, '""')}"`).join(',')).join('\r\n');
  const a = document.createElement('a'); a.href = URL.createObjectURL(new Blob([csv], { type: 'text/csv;charset=utf-8' }));
  const d = new Date(); a.download = `Grade5-Math-Scores-${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}.csv`;
  document.body.appendChild(a); a.click(); a.remove();
}

/* ---------------- wire up ---------------- */
document.querySelectorAll('[data-sort]').forEach(b => b.onclick = () => {
  sortMode = b.dataset.sort; document.querySelectorAll('[data-sort]').forEach(x => x.classList.toggle('on', x === b)); render(); });
document.querySelectorAll('[data-step]').forEach(b => b.onclick = () => {
  step = +b.dataset.step; document.querySelectorAll('[data-step]').forEach(x => x.classList.toggle('on', x === b)); render(); });
$('#q').oninput = e => { query = e.target.value.trim(); render(); };
$('#undoBtn').onclick = undo; $('#tUndo').onclick = () => { undo(); $('#toast').classList.remove('show'); };
$('#soundBtn').onclick = () => { sound = !sound; setSoundBtn(); save(); tone([660]); };
$('#csvBtn').onclick = exportCSV;
$('#resetAll').onclick = () => { $('#scrim').classList.add('show'); $('#mNo').focus(); };
$('#mNo').onclick = () => $('#scrim').classList.remove('show');
$('#mYes').onclick = () => { $('#scrim').classList.remove('show'); resetAll(); };
$('#scrim').onclick = e => { if (e.target.id === 'scrim') $('#scrim').classList.remove('show'); };
addEventListener('keydown', e => {
  if (e.key === 'Escape') $('#scrim').classList.remove('show');
  if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'z' && document.activeElement.tagName !== 'INPUT') { e.preventDefault(); undo(); }
});
$('#dateLbl').textContent = '· ' + new Date().toLocaleDateString('en-GB', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' });
$('#mText').textContent = `All ${STUDENTS.length} students will go back to 0. You can undo this straight after.`;

load(); setSoundBtn(); lastLeaders = leadersKey(); render();
</script>
